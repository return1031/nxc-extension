{
    "comments": {
      "lineComment": "//"
    },
    "brackets": [
      ["(", ")"]
    ],
    "autoClosingPairs": [
      { "open": "(", "close": ")" },
      { "open": "\"", "close": "\"" }
    ],
    "surroundingPairs": [
      ["(", ")"],
      ["\"", "\""]
    ],
    "indentationRules": {
      "increaseIndentPattern": "^\\s*(Loop|ImgCmp|ImgCmpRect|Rumble|Func)\\b.*",
      "decreaseIndentPattern": "^\\s*Not\\b.*"
    }
  }